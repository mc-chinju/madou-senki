{
  "name": "madou-senki",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.18.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "test": "pnpm test:unit && pnpm test:assets && pnpm test:worker",
    "test:unit": "vitest run",
    "test:assets": "python3 -m unittest scripts/test_prepare_assets.py",
    "test:worker": "pnpm --filter @madou/worker test",
    "typecheck": "tsc --noEmit && pnpm --filter @madou/worker typecheck && pnpm --filter @madou/web typecheck && pnpm typecheck:e2e",
    "typecheck:e2e": "tsc --noEmit -p tests/e2e/tsconfig.json",
    "test:e2e": "playwright test",
    "build": "pnpm --filter @madou/web build && pnpm --filter @madou/worker build",
    "verify:catalog": "python3 scripts/validate_second_edition.py",
    "prepare:assets": "python3 scripts/prepare_assets.py",
    "verify:assets": "python3 scripts/prepare_assets.py --verify"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "22.18.0",
    "typescript": "5.9.3",
    "vitest": "4.1.0"
  }
}
